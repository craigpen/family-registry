{
  "manifest_version": 3,
  "name": "Family wish lists",
  "short_name": "Wish lists",
  "version": "0.1.2",
  "description": "Add what you're looking at to your family wish list, or import an Amazon list.",
  "action": {
    "default_title": "Add to my wish list",
    "default_popup": "popup.html",
    "default_icon": { "32": "icon.png", "128": "icon.png" }
  },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://craigpen.github.io/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "wishlists@family-registry", "strict_min_version": "121.0" } }
}
