<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To open the wish list, and to fetch a shared page and its photos. Nothing is stored. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: to find a browser that can show the wish list full-screen. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- The site and this app belong together (the other half is craigpen.github.io/.well-known/assetlinks.json). -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!--
          The app icon: the wish list site, full-screen in Chrome (a Trusted Web Activity), with
          Chrome's sign-in and storage. Until Android has checked assetlinks.json it shows a thin
          address bar; without a capable browser it falls back to a Custom Tab.
        -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/app_url" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share from a shop: "Add to wish list" reads the page, then opens the app's Add screen. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
